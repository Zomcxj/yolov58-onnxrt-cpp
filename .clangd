# clangd 配置：CMake 的 MinGW 生成器把 include 路径放在 @rsp 里，clangd 不展开，这里显式补齐；
# 并指定 MinGW target（clangd 默认按 MSVC 解析，会加载不存在的 MSVC 头导致大量误报）。
# 不加 gcc 的 .../8.1.0/include（intrinsic 头目录）：与 clang 内置 builtin 定义冲突。
CompileFlags:
  Add:
    - --target=x86_64-w64-mingw32
    - -std=gnu++14
    - -Wno-builtin-definition
    - -ID:/VsPro/CPP/v58-onnxrt-v2/yolo
    - -ID:/VsPro/CPP/v58-onnxrt-v2/bytetrack
    - -ID:/VsPro/PTZ/rknn/v8_rknn/3rdparty/eigen3
    - -ID:/VsPro/CPP/onnxruntime-win-x64-1.14.0/include
    - -ID:/software/opencv/build/include
    - -isystem
    - D:/software/mingw64/lib/gcc/x86_64-w64-mingw32/8.1.0/include/c++
    - -isystem
    - D:/software/mingw64/lib/gcc/x86_64-w64-mingw32/8.1.0/include/c++/x86_64-w64-mingw32
    - -isystem
    - D:/software/mingw64/lib/gcc/x86_64-w64-mingw32/8.1.0/include/c++/backward
    - -isystem
    - D:/software/mingw64/x86_64-w64-mingw32/include
