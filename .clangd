# clangd 配置：MinGW Makefiles 生成器把 include 路径放在 @rsp 响应文件里，
# clangd 不展开 @rsp，这里显式补齐编译参数、MinGW 系统头路径与目标三元组
# （clangd 在 Windows 上默认按 MSVC target 解析，会去加载不存在的 MSVC 头导致误报）
# 注意：不加 gcc 的 .../8.1.0/include（intrinsic 头目录），clang 用自带 builtin 头，
# 混用会导致 "definition of builtin function '_mm_getcsr'" 类冲突
CompileFlags:
  Add:
    - --target=x86_64-w64-mingw32
    - -std=gnu++14
    - -Wno-builtin-definition   # mingw-w64 的 xmmintrin.h 与 clang 内置 SSE builtin 定义冲突，仅 clangd 诊断层面抑制
    - -ID:/VsPro/CPP/v58-onnxrt-v2/include
    - -ID:/VsPro/CPP/onnxruntime-win-x64-1.14.0/include
    - -ID:/software/opencv/build/include
    - -isystem
    - D:/software/mingw64/lib/gcc/x86_64-w64-mingw32/8.1.0/include/c++
    - -isystem
    - D:/software/mingw64/lib/gcc/x86_64-w64-mingw32/8.1.0/include/c++/x86_64-w64-mingw32
    - -isystem
    - D:/software/mingw64/lib/gcc/x86_64-w64-mingw32/8.1.0/include/c++/backward
    - -isystem
    - D:/software/mingw64/x86_64-w64-mingw32/include
